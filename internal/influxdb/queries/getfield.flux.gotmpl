data = from(bucket: "{{.Bucket}}")
    |> range(start: -{{.LookbackInterval}})
    |> filter(fn: (r) => r._measurement == "{{.Measurement}}" and r._field == "{{.Field}}")

min = data
    |> aggregateWindow(every: {{.TimeBucket}}, fn: min, createEmpty: false)
    |> set(key: "agg", value: "min")
max = data
    |> aggregateWindow(every: {{.TimeBucket}}, fn: max, createEmpty: false)
    |> set(key: "agg", value: "max")
avg = data
    |> aggregateWindow(every: {{.TimeBucket}}, fn: mean, createEmpty: false)
    |> set(key: "agg", value: "avg")
sum = data
    |> aggregateWindow(every: {{.TimeBucket}}, fn: sum, createEmpty: false)
    |> set(key: "agg", value: "sum")

union(tables: [min, max, avg, sum])
    |> pivot(rowKey: ["_time"], columnKey: ["agg"], valueColumn: "_value")
    |> keep(columns: ["_time", "min", "max", "avg", "sum"])
    |> sort(columns: ["_time"])
